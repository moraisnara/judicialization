# ── Raw data (26 GB — download via code/01_download/) ────────────────────────
data/raw/

# ── Clean data files too large for GitHub (> 100 MB) ─────────────────────────
data/clean/candidate_vote_panel.csv

# ── LaTeX compilation artifacts ───────────────────────────────────────────────
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.blg

# ── output/ whitelist ─────────────────────────────────────────────────────────
# Ignore everything under output/, then re-add the document sources (and the
# figures/tables folders) that this repo tracks. This repo is not linked to
# Overleaf: the Overleaf project links to moraisnara/phd-thesis, which takes flat
# copies of output/figures and output/tables through its sync_assets.sh.
# output/paper/ holds the written documents: the extended abstract, the paper
# draft (paper.tex) and the estimating-equations note.
output/*
!output/paper/
output/paper/*
!output/paper/*.tex
!output/paper/*.bib
!output/paper/*.bbl
!output/presentation/
output/presentation/*
# Deck SOURCES must be tracked. Whitelist by extension, not by filename: the old
# per-file list still named slides_full.tex / slides_conference.tex long after they
# were renamed, which silently left the entire report deck untracked.
!output/presentation/*.tex
!output/presentation/*.bib
# The frame library is a deck source too. output/presentation/* ignores the frames/
# directory, and git will not descend into an ignored directory -- so the
# directory must be un-ignored before the .tex inside it can be whitelisted.
# Same trap as above, one level down: without these two lines every frame in
# the deck is untracked while slides_report.tex (tracked) holds only \input lines.
!output/presentation/frames/
!output/presentation/frames/*.tex
# check_links.py verifies every deck button resolves.
!output/presentation/*.py
# DECK_WORKPLAN.md records the frame-by-frame review and its open design items;
# ignored, it existed only on one disk.
!output/presentation/*.md
!output/figures/
!output/tables/

# ── exploration/ outputs ───────────────────────────────────────────────────────
# Regenerable byproducts of hand-run exploration scripts. No document consumes
# them (that is why the scripts live in exploration/, not code/), so — unlike
# output/ above — nothing here is ever whitelisted back in.
exploration/output/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
*.tmp

