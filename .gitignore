# ── Raw data (6.9 GB — download via code/01_download/) ───────────────────────
data/raw/

# ── Clean data files too large for GitHub (> 100 MB) ─────────────────────────
data/clean/candidate_vote_panel.csv

# ── LaTeX compilation artifacts ───────────────────────────────────────────────
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.blg

# ── Overleaf whitelist ────────────────────────────────────────────────────────
# Ignore everything under output/, then re-add the source files (and the
# figures/tables folders) that the Overleaf-linked repo must track.
# output/paper/ holds written documents: extended_abstract now, full paper later.
output/*
!output/paper/
output/paper/*
!output/paper/*.tex
!output/paper/*.bib
!output/paper/*.bbl
!output/presentation/
output/presentation/*
# Deck SOURCES must be tracked. Whitelist by extension, not by filename: the old
# per-file list still named slides_full.tex / slides_conference.tex long after they
# were renamed, which silently left the entire report deck untracked.
!output/presentation/*.tex
!output/presentation/*.bib
!output/figures/
!output/tables/

# ── exploration/ outputs ───────────────────────────────────────────────────────
# Regenerable byproducts of hand-run exploration scripts. No document consumes
# them (that is why the scripts live in exploration/, not code/), so — unlike
# output/ above — nothing here is ever whitelisted back in.
exploration/output/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
*.tmp

# Secrets and stray artifacts
.env
Rplots.pdf

# Never commit data CSVs (large, regenerable)
*.csv

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/
