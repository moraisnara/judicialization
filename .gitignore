# ── Raw data (6.9 GB — download via code/01_download/) ───────────────────────
data/raw/

# ── Clean data files too large for GitHub (> 100 MB) ─────────────────────────
data/clean/candidate_vote_panel.csv

# ── LaTeX compilation artifacts ───────────────────────────────────────────────
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.blg

# ── Overleaf whitelist ────────────────────────────────────────────────────────
# Ignore everything under output/, then re-add the source files (and the
# figures/tables folders) that the Overleaf-linked repo must track.
# output/paper/ holds written documents: extended_abstract now, full paper later.
output/*
!output/paper/
output/paper/*
!output/paper/*.tex
!output/paper/*.bib
!output/paper/*.bbl
!output/presentation/
output/presentation/*
!output/presentation/slides_full.tex
!output/presentation/slides_conference.tex
!output/presentation/references.bib
!output/presentation/*.bib
!output/figures/
!output/tables/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
*.tmp

# Secrets and stray artifacts
.env
Rplots.pdf

# Never commit data CSVs (large, regenerable)
*.csv
