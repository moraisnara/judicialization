	file = {PDF:C\:\\Users\\naral\\Zotero\\storage\\LM65BE6M\\Marchetti e Cortez - 2009 - A judicialização da competição política o TSE e as coligações eleitorais.pdf:application/pdf},
}

@article{araujo_judicializacao_2023,
	title = {Judicialização da competição política e gênero: ação afirmativa nos Fundos Partidário e Eleitoral no Brasil},
	rights = {http://creativecommons.org/licenses/by-nc/4.0/},
	issn = {2178-4884, 0103-3352},
	url = {http://www.scielo.br/scielo.php?script=sci_arttext&pid=S0103-33522023000100205&tlng=pt},
	doi = {10.1590/0103-3352.2023.40.260812},
	shorttitle = {Judicialização da competição política e gênero},
	abstract = {Resumo: A reforma política no Brasil tem sido realizada, nos últimos vinte anos, no contexto da judicialização da política. Em uma de suas mais recentes ações no sistema eleitoral brasileiro, em 2018, o Poder Judiciário decidiu que os partidos políticos devem repassar no mínimo 30\% dos recursos do Fundo Partidário, do Fundo Especial de Financiamento de Campanha e do tempo de rádio e televisão para candidaturas de mulheres. Com esse pano de fundo, o presente artigo analisa a tensão entre Poder Judiciário, Poder Legislativo e os movimentos feministas no que diz respeito à inserção das mulheres na arena política. Conclui-se que, num cenário de obstáculos políticos, sociais e institucionais, a via da judicialização pode ser instrumentalizada positivamente pelo movimento feminista, mas não deixa de gerar tensões nos campos político e jurídico.
          , 
            Abstract: In the last twenty years in Brazil, political reform has taken place in a context of increasing judicialization. In one of its most recent interventions in the electoral system, the Judiciary decided in 2018 that political parties must transfer at least 30\% of the revenues of the Party Fund and of the Special Fund for Campaign Financing as well as of radio and television time to the campaigns of female candidates. In this context, this article analyzes the tension between the judiciary, the legislature and feminist movements around the women´s participation in the political arena. We conclude that, despite political, social and institutional obstacles, the feminist movement has been able to effectively employ judicialization. This strategy, however, generates tensions in the political and legal fields.},
	pages = {e260812},
	number = {40},
	journaltitle = {Revista Brasileira de Ciência Política},
	shortjournal = {Rev. Bras. Ciênc. Polít.},
	author = {Araújo, Clara Maria De Oliveira and Rodrigues, Theófilo Codeço Machado},
	urldate = {2025-04-08},
	date = {2023},
	langid = {portuguese},
	file = {PDF:C\:\\Users\\naral\\Zotero\\storage\\NTDHMXFK\\Araújo e Rodrigues - 2023 - Judicialização da competição política e gênero ação afirmativa nos Fundos Partidário e Eleitoral no.pdf:application/pdf},
